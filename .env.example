# NIT Hamirpur Informatics System (NITH-IS) Configuration
# Configure your official email sending provider below to deliver OTPs to real @nith.ac.in inboxes:

# Option 1: Standard SMTP / Google Workspace / Gmail App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="NIT Hamirpur Informatics System <your_email@gmail.com>"

# Option 2: Resend API
RESEND_API_KEY=re_example_key
RESEND_FROM="NIT Hamirpur Informatics System <onboarding@resend.dev>"

# Supabase Cloud Database Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
